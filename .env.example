# Personalized Learning Agent — environment config template.
# Copy to .env and fill in real values:  cp .env.example .env

# Email (SMTP) - For Gmail, use a 16-character App Password (not your login password).
# https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=you@gmail.com
SENDER_PASSWORD="your app password"

# Where the digest is sent
RECIPIENT_EMAIL=you@example.com

# Optional: claude model to use (defaults to "opus" if unset)
# CLAUDE_MODEL=opus
